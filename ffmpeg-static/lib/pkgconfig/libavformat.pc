prefix=F:/ffbuild/prefix
exec_prefix=${prefix}
libdir=F:/ffbuild/prefix/lib
includedir=F:/ffbuild/prefix/include

Name: libavformat
Description: FFmpeg container format library
Version: 63.1.100
Requires: libavcodec >= 63.1.100, libswresample >= 7.1.100, libavutil >= 61.1.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavformat -lm -latomic -lsecur32 -lncrypt -lcrypt32 -lws2_32
Libs.private: 
Cflags: -I${includedir}
